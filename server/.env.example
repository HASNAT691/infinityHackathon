# Local replica set (needed for transactions) or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27018/novaworks?replicaSet=rs0&directConnection=true
SESSION_SECRET=replace-with-32-plus-random-chars
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=model-id-from-openrouter
OPENROUTER_FALLBACK_MODEL=backup-model-id
PORT=5000
